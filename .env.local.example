# Database
DATABASE_URL="postgresql://username:password@localhost:5432/jetblue_optimizer"

# Schedule API Configuration
SCHEDULE_API_PROVIDER=aerodatabox
SCHEDULE_API_KEY=your_aerodatabox_api_key_here

# Sync Configuration
SCHEDULE_SYNC_AIRPORTS=JFK,LGA,EWR,BOS,FLL,LAX,SFO,DEN,SEA,MCO,TPA,BWI,DCA,PHL,SJU
SCHEDULE_SYNC_WINDOW_DAYS=30
SCHEDULE_RETENTION_DAYS=7

# Google Maps API Key
# Get your API key from: https://console.developers.google.com/
# Enable the following APIs:
# - Maps JavaScript API
# - Places API (if using places features)
# - Geocoding API (if using geocoding features)
#
# Add your domain/localhost to the API key restrictions:
# - For development: http://localhost:3000, http://localhost:3001
# - For production: your-domain.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Existing configuration (keep these if already set)
# NEXT_PUBLIC_VERCEL_URL=
# VERCEL_URL=